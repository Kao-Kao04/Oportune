# Copy to .env.local and fill in values. Never commit real secrets.
# Only NEXT_PUBLIC_* values are sent to the browser.

NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# Supabase (URL and publishable key are public by design; RLS protects the data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...): bypasses RLS. Server-only, for jobs and admin actions.
SUPABASE_SECRET_KEY=
DATABASE_URL=

# Reminder emails
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=

# Web push notifications (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# Protects the scheduled-job endpoints (reminders, auto-expire)
CRON_SECRET=

# Rate limiting (leave empty to use the Postgres rate_limits table)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Salt for hashing IPs in rate-limit keys
RATE_LIMIT_IP_SALT=

# Captcha on logged-out forms (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

ERROR_TRACKING_DSN=
