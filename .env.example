# Copy to .env.local and fill in values. Never commit real secrets.
# Only NEXT_PUBLIC_* values are sent to the browser.

NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# Supabase (URL and anon key are public by design; RLS protects the data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Reminder emails
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=

# Web push notifications (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# Protects the scheduled-job endpoints (reminders, auto-expire)
CRON_SECRET=

ERROR_TRACKING_DSN=
