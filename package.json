{
  "name": "oportune",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db": "node scripts/supabase-db.mjs",
    "import:opportunities": "tsx scripts/import-opportunities.ts",
    "test": "vitest run",
    "publish:drafts": "tsx scripts/publish-drafts.ts",
    "db:types": "node scripts/supabase-db.mjs gen types typescript --schema public > src/lib/supabase/database.types.ts",
    "grant-role": "tsx scripts/grant-role.ts",
    "smoke": "tsx scripts/smoke.ts",
    "ux:check": "node scripts/ux-check.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.12"
  }
